{
  "name": "swatch",
  "version": "0.1.0",
  "description": "Edit your CSS colour tokens live, on the page. A dev-only panel for Vite that finds the custom properties in your stylesheets, previews edits on the real app, and writes them back to the file.",
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "css-variables",
    "colour",
    "color",
    "vite-plugin",
    "dark-mode",
    "wcag",
    "devtools"
  ],
  "license": "MIT",
  "author": "tyfoster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyfoster/swatch.git"
  },
  "homepage": "https://github.com/tyfoster/swatch#readme",
  "bugs": "https://github.com/tyfoster/swatch/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json && node build.mjs --types",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "example": "npm run build && vite example",
    "site": "vite site",
    "site:build": "vite build site",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "postcss": "^8.5.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "swatch": "./dist/cli.js"
  }
}
